# Rehearsal template; never put real secrets in this tracked file.
# Copy to /home/ubuntu/.config/phrasebud-backup/backup.env, mode 600.
# Do not start a job until repository, restricted credentials and password exist.
READWORDS_BACKUP_PROJECT=phrasebud-backup-preview
READWORDS_IMAGE=readwords:phrasebud-amd64
READWORDS_DATA_VOLUME=phrasebud-preview_preview-data
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/home/ubuntu/.config/phrasebud-backup/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-singapore

# COS requires virtual-hosted bucket access; other providers default to auto.
READWORDS_RESTIC_S3_BUCKET_LOOKUP=dns

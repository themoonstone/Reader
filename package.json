{
  "name": "readwords",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app lib tests scripts proxy.ts next.config.ts playwright.config.ts playwright.cloud.config.ts postcss.config.mjs package.json tsconfig.json",
    "format:check": "prettier --check app lib tests scripts proxy.ts next.config.ts playwright.config.ts playwright.cloud.config.ts postcss.config.mjs package.json tsconfig.json",
    "guide:generate": "node --import tsx scripts/generate-guide.mts",
    "guide:check": "node --import tsx scripts/generate-guide.mts --check",
    "ops": "node scripts/ops.mts",
    "backup:run": "node scripts/backup-job.mts",
    "test:e2e:cloud": "playwright test --config playwright.cloud.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "exceljs": "^4.4.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}

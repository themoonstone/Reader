# Default local mode: loopback only, no login; never expose it on the internet.
READWORDS_MODE=local
# READWORDS_DB_PATH=/absolute/path/readwords.sqlite
# READWORDS_READ_ONLY=1

# Cloud: configure all values below. Missing/invalid config fails closed.
# READWORDS_MODE=cloud
# READWORDS_ORIGIN=https://your-domain.example
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# READWORDS_OWNER_ID=your-auth-user-uuid
# READWORDS_OWNER_EMAIL=your-own-email@example.com
# TZ=Asia/Shanghai

# Docker Compose --env-file .env.cloud (file is ignored by Git)
# READWORDS_DOMAIN=your-domain.example
# RESTIC_REPOSITORY=s3:https://your-independent-storage.example/bucket
# RESTIC_PASSWORD_FILE=/absolute/private/path/restic-password
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=...
# READWORDS_BACKUP_DIR=/absolute/path/backups
